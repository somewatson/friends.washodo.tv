# Twitch API Credentials
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Webhook Configuration
# Comma-separated list of webhook URLs (e.g., Mattermost, Discord)
WEBHOOK_URLS=your_webhook_url_1,your_webhook_url_2

# Bot Settings
# Comma-separated list of Twitch usernames to watch
TRACKED_STREAMERS=streamer1,streamer2,streamer3

# Path to the SQLite database file
DATABASE_PATH=/app/data/streamers.db

# Mattermost Bot accounts configuration (Comma-separated list of token|url|channel)
# Example: token1|https://mattermost.server1.com|channelId1,token2|https://mattermost.server2.com|channelId2
MATTERMOST_BOTS=

# Cron expression for check interval (default: every 5 minutes)
CHECK_INTERVAL=*/5 * * * *
