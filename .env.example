# --- Docker / Deployment ---
UID=1000
GID=1000
APP_ENV=development
PORT=3000
API_KEY=your_secure_api_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
BASE_URL=https://your-bot-url.com
DATABASE_PATH=./data/streamers.db

# --- Twitch API ---
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
CHECK_INTERVAL="*/5 * * * *"

# --- Discord Integration ---
DISCORD_BOT_PORT=3001
DISCORD_BOT_RUNNER_URL=http://localhost:3001
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# --- Visual Loop & Browserless ---
# ngrok Auth Token for creating tunnels
NGROK_AUTHTOKEN=your_ngrok_token_here
# ngrok API Key for monitoring usage and limits
NGROK_API_KEY=your_ngrok_api_key_here
# Browserless API Token
BROWSERLESS_TOKEN=your_browserless_token_here
# Base Browserless URL (e.g., https://5d56-99-65-7-49.ngrok-free.app)
BROWSERLESS_URL=https://your-browserless-url.ngrok-free.app
# Path to save screenshots for analysis
SCREENSHOT_DIR=./visual-loop/screenshots

# Tunneling Configuration
# TUNNEL_MODE: 'AUTO' (use TUNNEL_URL if present, else spin up), 'MANUAL' (must use TUNNEL_URL), 'SPINUP' (always spin up)
TUNNEL_MODE=AUTO
# The public URL of the tunnel (used if TUNNEL_MODE is AUTO or MANUAL). Cloudflare tunnels use *.trycloudflare.com
TUNNEL_URL=https://your-tunnel-url.trycloudflare.com

# --- Other Configs ---
RECURRING_NOTIFICATION_MINUTES=180
BOT_SCHEDULE_TEXT="The Washodo gang are making a content house in Japan in March 2027! Support them by tuning into their streams from now until then! Collabs every Friday at 9PM PST and Sunday at 12PM PST. Check out the Twitch team!"

UMAMI_WEBSITE_ID=your_umami_website_id_here
UMAMI_ENDPOINT=https://umami.website.com/api/send
